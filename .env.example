# Ollama is already running on the host. For Docker Desktop, host.docker.internal
# usually reaches the host service; for a local Python run use localhost.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_LENGTH=8192
API_MODEL_NAME=qwen3.5:9b-maps

# PRIVATE: used only by this backend for Places API (New).
GOOGLE_PLACES_API_KEY=

# OPTIONAL and public by design: returned only for API clients that choose to
# render live Maps Embed previews. The UI falls back to external Maps links when omitted.
# Restrict it to Maps Embed API and your exact website referrers.
GOOGLE_MAPS_EMBED_API_KEY=

# Strongly recommended outside localhost. Open WebUI and the demo page send
# this value in the Authorization: Bearer header.
APP_API_KEY=

# Comma-separated origins, with no trailing slash.
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,maps-api

# Backend protection; Google Cloud quotas are an additional, separate control.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_PLACE_RESULTS=5
GOOGLE_REQUEST_TIMEOUT_SECONDS=25
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
